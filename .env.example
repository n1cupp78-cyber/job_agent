# Copy this file to .env and fill in the keys you have.
# .env is git-ignored; never commit real keys.

# Adzuna (required for the main job search): https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# USAJobs (optional): https://developer.usajobs.gov/
USAJOBS_API_KEY=
USAJOBS_EMAIL=

# Anthropic (optional, enables AI relevance scoring): https://console.anthropic.com/
ANTHROPIC_API_KEY=
